# ============================================================================
# Hil_Delivre v4 — Sprint 5 : Variables d'environnement
# ============================================================================

# --- Supabase (existant depuis Sprint 1) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT (existant depuis Sprint 2) ---
JWT_SECRET=your-jwt-secret

# --- PayDunya (existant depuis Sprint 4) ---
PAYDUNYA_MASTER_KEY=your-master-key
PAYDUNYA_PRIVATE_KEY=your-private-key
PAYDUNYA_PUBLIC_KEY=your-public-key
PAYDUNYA_TOKEN=your-token
PAYDUNYA_MODE=test

# --- OSRM (Sprint 5) ---
# URL de l'instance OSRM. Par défaut : serveur public.
# En production, utiliser une instance self-hosted pour la fiabilité.
OSRM_BASE_URL=https://router.project-osrm.org

# --- Livraison (Sprint 5) ---
# Rayon de recherche initial des livreurs (km)
DELIVERY_SEARCH_RADIUS_KM=5
# Rayon élargi pour les rounds suivants (km)
DELIVERY_EXPANDED_RADIUS_KM=10
# Timeout d'une proposition de course (secondes)
DELIVERY_ASSIGNMENT_TIMEOUT_S=60
# Nombre maximum de rounds d'assignation
DELIVERY_MAX_ROUNDS=3
# Distance maximum de livraison (km)
DELIVERY_MAX_DISTANCE_KM=30

# --- Serveur ---
PORT=3000
NODE_ENV=development
