# Fichier d'environnement exemple pour le backend Hil_Delivre
# Renommez ce fichier en .env et remplissez les valeurs appropriées.

# Supabase Configuration
SUPABASE_URL="VOTRE_URL_SUPABASE"
SUPABASE_ANON_KEY="VOTRE_CLE_ANON_SUPABASE"
SUPABASE_SERVICE_ROLE_KEY="VOTRE_CLE_SERVICE_ROLE_SUPABASE" # Utilisée pour les opérations admin côté serveur

# PayDunya Configuration
PAYDUNYA_MASTER_KEY="VOTRE_CLE_MASTER_PAYDUNYA"
PAYDUNYA_PRIVATE_KEY="VOTRE_CLE_PRIVEE_PAYDUNYA"
PAYDUNYA_TOKEN="VOTRE_TOKEN_PAYDUNYA"
PAYDUNYA_MODE="test" # ou "live"
PAYDUNYA_WEBHOOK_SECRET="VOTRE_SECRET_WEBHOOK_PAYDUNYA"

# JWT Secret pour l'authentification (peut être généré aléatoirement)
JWT_SECRET="VOTRE_SECRET_JWT_FORT"

# Port du serveur Express
PORT=3000

# ID de l'utilisateur administrateur pour le crédit des abonnements
ADMIN_USER_ID="VOTRE_UUID_ADMIN_SUPABASE" # L'ID de l'utilisateur avec le rôle 'admin'
