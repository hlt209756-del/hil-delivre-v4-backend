# ============================================================================
# Hil_Delivre v4 — Sprint 4 : Variables d'environnement
# ============================================================================

# --- Supabase (existant depuis Sprint 1) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret

# --- PayDunya (NOUVEAU Sprint 4) ---
# Mode : 'test' pour sandbox, 'live' pour production
PAYDUNYA_MODE=test
# Clés API PayDunya (obtenues sur https://app.paydunya.com)
PAYDUNYA_MASTER_KEY=your-paydunya-master-key
PAYDUNYA_PRIVATE_KEY=your-paydunya-private-key
PAYDUNYA_TOKEN=your-paydunya-token

# --- URLs de l'application (NOUVEAU Sprint 4) ---
# URL de base de l'API backend (pour les callbacks webhook)
API_BASE_URL=https://api.hildelivre.bf
# URL de l'application frontend/mobile (pour les redirections post-paiement)
APP_URL=https://app.hildelivre.bf

# --- Informations entreprise (NOUVEAU Sprint 4 - pour factures FEC) ---
COMPANY_RCCM=BF-OUA-XXXX-XXXXX
COMPANY_IFU=XXXXXXXXX
COMPANY_EMAIL=facturation@hildelivre.bf
STORE_PHONE=+22670000000

# --- Serveur (existant) ---
PORT=3000
NODE_ENV=development
