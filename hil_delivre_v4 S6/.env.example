# ============================================================================
# Hil_Delivre v4 — Sprint 6 : Variables d'environnement
# ============================================================================

# --- Supabase (existant depuis Sprint 1) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT (existant depuis Sprint 2) ---
JWT_SECRET=your-jwt-secret

# --- PayDunya (existant depuis Sprint 4) ---
PAYDUNYA_MASTER_KEY=your-master-key
PAYDUNYA_PRIVATE_KEY=your-private-key
PAYDUNYA_PUBLIC_KEY=your-public-key
PAYDUNYA_TOKEN=your-token
PAYDUNYA_MODE=test

# --- OSRM (existant depuis Sprint 5) ---
OSRM_BASE_URL=https://router.project-osrm.org

# --- Firebase Cloud Messaging (Sprint 6) ---
# Clé serveur FCM (Legacy API) — depuis Firebase Console > Project Settings > Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# --- Africa's Talking SMS (Sprint 6) ---
# Documentation : https://africastalking.com/docs/sms
AFRICASTALKING_API_KEY=your-at-api-key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=HilDelivre
AFRICASTALKING_ENV=sandbox

# --- Socket.IO (Sprint 6) ---
# Origins autorisés pour les connexions WebSocket (séparés par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# --- Serveur ---
PORT=3000
NODE_ENV=development
