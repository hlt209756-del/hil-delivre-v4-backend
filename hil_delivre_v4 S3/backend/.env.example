# ============================================================
# Hil_Delivre v4 — Variables d'environnement
# Sprint 2 : Authentification, KYC, Profils
# ============================================================
# Copier ce fichier vers .env et remplir avec vos valeurs réelles :
#   cp .env.example .env
# ============================================================

# --- Environnement ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Supabase ---
# URL de votre projet Supabase (Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique (anon) — utilisée côté client et pour les opérations RLS
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé de service (service_role) — JAMAIS exposée côté client
# Bypass RLS — utilisée uniquement côté backend pour les opérations admin
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- CORS ---
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:19006,https://app.hildelivre.bf

# --- Application ---
# URL de base de l'application (pour les liens dans les emails)
APP_URL=https://app.hildelivre.bf

# --- Rate Limiting (optionnel — valeurs par défaut si non défini) ---
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=20
