{
  "name": "hil-delivre-backend",
  "version": "2.0.0",
  "description": "Backend API pour Hil_Delivre v4 — Sprint 2 : Auth, KYC, Profils",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage --verbose --forceExit",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --verbose --forceExit --ci",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 35,
        "functions": 45,
        "lines": 45,
        "statements": 45
      }
    }
  },
  "author": "Hil_Delivre Team",
  "license": "Proprietary"
}
