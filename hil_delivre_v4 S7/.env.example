# ============================================================================
# Hil_Delivre v4 — Sprint 7 : Variables d'environnement
# ============================================================================

# --- Supabase (existant depuis Sprint 1) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- JWT (existant depuis Sprint 2) ---
JWT_SECRET=your-jwt-secret

# --- PayDunya (existant depuis Sprint 4) ---
PAYDUNYA_MASTER_KEY=your-master-key
PAYDUNYA_PRIVATE_KEY=your-private-key
PAYDUNYA_PUBLIC_KEY=your-public-key
PAYDUNYA_TOKEN=your-token
PAYDUNYA_MODE=test

# --- OSRM (existant depuis Sprint 5) ---
OSRM_BASE_URL=https://router.project-osrm.org

# --- FCM (existant depuis Sprint 6) ---
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-firebase-project-id

# --- Africa's Talking (existant depuis Sprint 6) ---
AFRICASTALKING_API_KEY=your-at-api-key
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=HilDelivre
AFRICASTALKING_ENV=sandbox

# --- Admin Panel (Sprint 7) ---
# URL du panel admin web (pour les liens dans les notifications)
ADMIN_PANEL_URL=http://localhost:3001
# Nombre max de jours pour la période de réconciliation
MAX_RECONCILIATION_PERIOD_DAYS=31
# Seuil d'alerte cash (FCFA) - notifie l'admin si un livreur dépasse ce montant
CASH_ALERT_THRESHOLD=100000

# --- Serveur ---
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:19006
