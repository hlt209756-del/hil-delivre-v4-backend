# ─────────────────────────────────────────────────────────────────────────────
# Hil_Delivre v4 — Sprint 10 — Variables d'environnement
# ─────────────────────────────────────────────────────────────────────────────
# Copier ce fichier en .env et remplir les valeurs.
# NE JAMAIS committer le fichier .env dans le dépôt.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_VERSION=4.10.0

# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/hil_delivre
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=5000

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-min-256-bits
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── PayDunya ─────────────────────────────────────────────────────────────────
PAYDUNYA_MASTER_KEY=your-master-key
PAYDUNYA_PRIVATE_KEY=your-private-key
PAYDUNYA_PUBLIC_KEY=your-public-key
PAYDUNYA_TOKEN=your-token
PAYDUNYA_WEBHOOK_TOKEN=your-webhook-token
PAYDUNYA_MODE=test

# ─── Africa's Talking (SMS/OTP) ──────────────────────────────────────────────
AFRICAS_TALKING_API_KEY=your-api-key
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=HilDelivre

# ─── Firebase Cloud Messaging ─────────────────────────────────────────────────
FCM_SERVER_KEY=your-fcm-server-key

# ─── OSRM (Routing) ──────────────────────────────────────────────────────────
OSRM_BASE_URL=http://localhost:5000
OSRM_TIMEOUT=5000

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
PROMETHEUS_METRICS_TOKEN=your-prometheus-token-min-32-chars

# ─── Cache Configuration ──────────────────────────────────────────────────────
CACHE_TTL_DASHBOARD=60
CACHE_TTL_USER=300
CACHE_TTL_MENU=600
CACHE_TTL_ORDER=120
CACHE_TTL_DELIVERY=30
CACHE_TTL_STATS=3600
CACHE_CIRCUIT_BREAKER_THRESHOLD=5
CACHE_CIRCUIT_BREAKER_TIMEOUT=30000

# ─── Export Configuration ─────────────────────────────────────────────────────
EXPORT_MAX_ROWS=50000
EXPORT_RATE_LIMIT=5
EXPORT_FILE_EXPIRY_HOURS=24
EXPORT_STORAGE_BUCKET=hil-delivre-exports

# ─── Cron Jobs ────────────────────────────────────────────────────────────────
CRON_DISABLE_DAILY_STATS=false
CRON_DISABLE_HEALTH_CHECK=false
CRON_DISABLE_CLEANUP_OTP=false
CRON_DISABLE_CLEANUP_EXPORTS=false
CRON_DISABLE_CACHE_WARMUP=false
CRON_DAILY_STATS_HOUR=1
CRON_HEALTH_CHECK_INTERVAL=5m
CRON_CLEANUP_OTP_INTERVAL=1h
CRON_CLEANUP_EXPORTS_INTERVAL=6h
CRON_CACHE_WARMUP_INTERVAL=5m

# ─── Alertes ──────────────────────────────────────────────────────────────────
CASH_ALERT_THRESHOLD=500000
HEALTH_DEGRADED_THRESHOLD_MS=1000
HEALTH_UNHEALTHY_THRESHOLD_MS=5000

# ─── Grafana (Docker Compose uniquement) ──────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-production

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ADMIN=120
RATE_LIMIT_USER=60
RATE_LIMIT_WINDOW_MS=60000
