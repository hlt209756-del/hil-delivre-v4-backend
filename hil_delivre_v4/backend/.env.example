# ============================================================
# Hil_Delivre v4 — Variables d'environnement backend
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# ============================================================

# Port du serveur
NODE_ENV=production
PORT=3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS=https://app.hildelivre.bf,https://admin.hildelivre.bf

# Rate limiting (en millisecondes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
